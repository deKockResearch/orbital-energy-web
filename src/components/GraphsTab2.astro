---
import TabLayout from "../layouts/TabLayout.astro";

import { elements } from "../scripts/elements";
import { type ElementType } from '../scripts/types';

import { COLUMN_NAMES } from "../scripts/excelSheet";

import { read, utils } from "xlsx";

/* parse workbook */
import b64 from "../assets/081425Data.xlsx";
import GraphSubChoice from "./GraphSubChoice.astro";
const wb = read(b64, { type: "base64" });

const dataFromExcelSheet = utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]],
  {
    range: 'C5:FD122',
    header: COLUMN_NAMES,
  });


---

<TabLayout tabName="New Graphs" id="graphs2-tab">
  <!-- Put the data into the DOM, so it can be extracted by the client-side code. -->
  <div id="excel-data" data-excelsheet={JSON.stringify(dataFromExcelSheet)}></div>

  <div class="y-choice-and-chart-container">
    <div class="y-menu radio-collection">
      <div>Choose Y-axis item</div>
      <div>
        <label for="y_z">Atomic number</label>
        <input type="radio" id="y_z" value="z" name="y-graph-value"  />
      </div>
      <div>
        <label for="y_amass">Atomic mass</label>
        <input type="radio" id="y_amass" value="amass" name="y-graph-value"  />
      </div>
      <div>
        <label for="y_effnuccharge">Eff. Nuclear Charge (Z<sub>eff</sub>)</label>
        <input type="radio" id="y_effnuccharge" value="effnuccharge" name="y-graph-value"  />
      </div>
      <div>
        <label for="y_orbrad">Orbital Radius</label>
        <input type="radio" id="y_orbrad" value="orbrad" name="y-graph-value" />
      </div>
      <div>
        <label for="y_atomrad">Atomic Radius</label>
        <input type="radio" id="y_atomrad" value="atomrad" name="y-graph-value"  />
      </div>
      <div>
        <label for="y_ke">Kinetic Energy</label>
        <input type="radio" id="y_ke" value="ke" name="y-graph-value"  />
      </div>
      <div>
        <label for="y_pe">Potential Energy</label>
        <input type="radio" id="y_pe" value="pe" name="y-graph-value"  />
      </div>
      <div>
        <label for="y_te">Total Energy</label>
        <input type="radio" id="y_te" value="te" name="y-graph-value"  />
      </div>
      <div>
        <label for="y_ie">Ionization Energy</label>
        <input type="radio" id="y_ie" value="ie" name="y-graph-value"  />
      </div>
      <div>
        <label for="y_electroneg">Electronegativity</label>
        <input type="radio" id="y_electroneg" value="electroneg" name="y-graph-value" />
      </div>
      <div>
        <label for="y_density">Density</label>
        <input type="radio" id="y_density" value="density" name="y-graph-value" />
      </div>
      <div>
        <label for="y_melting">Melting Point</label>
        <input type="radio" id="y_melting" value="melting" name="y-graph-value" />
      </div>
      <div>
        <label for="y_boiling">Boiling Point</label>
        <input type="radio" id="y_boiling" value="boiling" name="y-graph-value" />
      </div>
    </div>

    <GraphSubChoice xOrY="y" />

    <div id="chart-attachment">
      <canvas id="chart2-canv"></canvas>
    </div>
  </div>

  <!-- https://medium.com/@predragdavidovic10/native-dual-range-slider-html-css-javascript-91e778134816 -->
  <div class="range_container">
    <div class="sliders_control">
      <input id="fromSlider" type="range" value="1" min="1" max="118"/>
      <input id="toSlider" type="range" value="18" min="1" max="118"/>
    </div>
    <div class="form_control">
      <div class="form_control_container">
        <div class="form_control_container__time">From</div>
        <input class="form_control_container__time__input" type="number" id="fromInput" value="1" min="1" max="118"/>
      </div>
      <div class="form_control_container">
        <div class="form_control_container__time">To</div>
        <input class="form_control_container__time__input" type="number" id="toInput" value="18" min="1" max="118"/>
      </div>
    </div>
  </div>

  <div class="x-menu-row">
    <div class="x-menu radio-collection">
      <div>Choose X-axis item</div>
      <div>
        <label for="x_z">Atomic number</label>
        <input type="radio" id="x_z" value="z" name="x-graph-value" />
      </div>
      <div>
        <label for="x_amass">Atomic mass</label>
        <input type="radio" id="x_amass" value="amass" name="x-graph-value" />
      </div>
      <div>
        <label for="x_effnuccharge">Eff. Nuclear Charge (Z<sub>eff</sub>)</label>
        <input type="radio" id="x_effnuccharge" value="effnuccharge" name="x-graph-value" />
      </div>
      <div>
        <label for="x_orbrad">Orbital Radius</label>
        <input type="radio" id="x_orbrad" value="orbrad" name="x-graph-value" />
      </div>
      <div>
        <label for="x_atomrad">Atomic Radius</label>
        <input type="radio" id="x_atomrad" value="atomrad" name="x-graph-value" />
      </div>
      <div>
        <label for="x_ke">Kinetic Energy</label>
        <input type="radio" id="x_ke" value="ke" name="x-graph-value" />
      </div>
      <div>
        <label for="x_pe">Potential Energy</label>
        <input type="radio" id="x_pe" value="pe" name="x-graph-value" />
      </div>
      <div>
        <label for="x_te">Total Energy</label>
        <input type="radio" id="x_te" value="te" name="x-graph-value" />
      </div>
      <div>
        <label for="x_ie">Ionization Energy</label>
        <input type="radio" id="x_ie" value="ie" name="x-graph-value" />
      </div>
      <div>
        <label for="x_electroneg">Electronegativity</label>
        <input type="radio" id="x_electroneg" value="electroneg" name="x-graph-value" />
      </div>
      <div>
        <label for="x_density">Density</label>
        <input type="radio" id="x_density" value="density" name="x-graph-value" />
      </div>
      <div>
        <label for="x_melting">Melting Point</label>
        <input type="radio" id="x_melting" value="melting" name="x-graph-value" />
      </div>
      <div>
        <label for="x_boiling">Boiling Point</label>
        <input type="radio" id="x_boiling" value="boiling" name="x-graph-value" />
      </div>
      <!-- <div>
        <label for="x_polarizability">Polarizability</label>
        <input type="radio" id="x_polarizability" value="polarizability" name="x-graph-value" />
      </div> -->

    </div>



    <GraphSubChoice xOrY="x" />
  </div>



</TabLayout>

<script>
  import "../scripts/graphData2.ts"
</script>

<style>

  .y-choice-and-chart-container,
  .x-menu-row {
    display: flex;
  }

  #chart-attachment {
    width: 1200px;
    height: 600px;
  }

  .space-above {
    margin-block-start: 3rem;
  }

  .y-menu {
    /* y-menu should not shrink when the window size is too narrow */
    flex-shrink: 0;
  }

  .x-menu {
    width: 300px;
    padding-inline-start: 100px;
  }

  .radio-collection > div {
    margin-left: auto;
    margin-right: 0;
    display: table;   /* not sure why this works... */
  }

/* Double-thumb slider */
/* https://medium.com/@predragdavidovic10/native-dual-range-slider-html-css-javascript-91e778134816 */

.range_container {
  display: flex;
  flex-direction: column;
  width: 80%;
  /* margin: 35% auto; */
  margin: auto;
  padding-left: 15rem;
  padding-top: 16px;
}

.sliders_control {
  position: relative;
  min-height: 25px;
}

.form_control {
  position: relative;
  display: flex;
  justify-content: space-between;
  font-size: 16px;
  color: black;
  padding-bottom: 16px;
}

input[type=range]::-webkit-slider-thumb {
  -webkit-appearance: none;
  pointer-events: all;
  width: 24px;
  height: 24px;
  background-color: #fff;
  border-radius: 50%;
  box-shadow: 0 0 0 1px black;
  cursor: pointer;
}

input[type=range]::-moz-range-thumb {
  -webkit-appearance: none;
  pointer-events: all;
  width: 24px;
  height: 24px;
  background-color: #fff;
  border-radius: 50%;
  box-shadow: 0 0 0 1px black;
  cursor: pointer;
}

input[type=range]::-webkit-slider-thumb:hover {
  background: #f7f7f7;
}

input[type=range]::-webkit-slider-thumb:active {
  box-shadow: inset 0 0 3px #387bbe, 0 0 9px #387bbe;
  -webkit-box-shadow: inset 0 0 3px #387bbe, 0 0 9px #387bbe;
}

input[type="number"] {
  color: black;
  width: 50px;
  height: 30px;
  font-size: 16px;
  border: none;
}

input[type=number]::-webkit-inner-spin-button,
input[type=number]::-webkit-outer-spin-button {
   opacity: 1;
}

input[type="range"] {
  -webkit-appearance: none;
  appearance: none;
  height: 2px;
  width: 100%;
  position: absolute;
  background-color: black;
  pointer-events: none;
}

#fromSlider {
  height: 0;
  z-index: 1;
}



</style>
